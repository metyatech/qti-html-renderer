{
  "name": "qti-html-renderer",
  "version": "0.1.2",
  "description": "Reusable QTI 3.0 assessment item HTML rendering utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metyatech/qti-html-renderer.git"
  },
  "homepage": "https://github.com/metyatech/qti-html-renderer",
  "bugs": {
    "url": "https://github.com/metyatech/qti-html-renderer/issues"
  },
  "keywords": [
    "qti",
    "qti3",
    "qti-3",
    "html",
    "renderer",
    "education"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "qti-xml-core": "git+https://github.com/metyatech/qti-xml-core.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jsdom": "^28.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,md}": [
      "prettier --check"
    ]
  }
}